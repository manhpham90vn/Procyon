{
  "$description": "Procyon design tokens: the single source of truth for every platform UI. Run scripts/gen-tokens.py after editing.",
  "color": {
    "background":      { "light": "#F3F5F9", "dark": "#0A0C11" },
    "surface":         { "light": "#FFFFFF", "dark": "#12151C" },
    "surfaceRaised":   { "light": "#F8F9FC", "dark": "#191D26" },
    "surfaceSunken":   { "light": "#ECEFF4", "dark": "#0E1117" },
    "border":          { "light": "#0F172A14", "dark": "#FFFFFF12" },
    "borderStrong":    { "light": "#0F172A26", "dark": "#FFFFFF24" },
    "textPrimary":     { "light": "#0F172A", "dark": "#F1F4F9" },
    "textSecondary":   { "light": "#475569", "dark": "#9AA4B6" },
    "textTertiary":    { "light": "#94A3B8", "dark": "#5F6B80" },
    "accent":          { "light": "#4F46E5", "dark": "#818CF8" },
    "success":         { "light": "#059669", "dark": "#34D399" },
    "warning":         { "light": "#D97706", "dark": "#FBBF24" },
    "danger":          { "light": "#DC2626", "dark": "#F87171" },
    "chartGrid":       { "light": "#0F172A0F", "dark": "#FFFFFF0D" },
    "track":           { "light": "#0F172A0F", "dark": "#FFFFFF0F" }
  },
  "metric": {
    "cpu":     { "start": "#3B82F6", "end": "#22D3EE", "symbol": "cpu" },
    "memory":  { "start": "#8B5CF6", "end": "#EC4899", "symbol": "memorychip" },
    "disk":    { "start": "#F59E0B", "end": "#F97316", "symbol": "internaldrive" },
    "network": { "start": "#10B981", "end": "#84CC16", "symbol": "network" },
    "gpu":     { "start": "#F43F5E", "end": "#FB923C", "symbol": "cube.transparent" },
    "battery": { "start": "#A3E635", "end": "#22C55E", "symbol": "battery.100percent" },
    "energy":  { "start": "#FACC15", "end": "#A3E635", "symbol": "bolt.fill" }
  },
  "space":  { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999 },
  "font": {
    "display":  { "size": 34, "weight": "bold",     "design": "rounded" },
    "title":    { "size": 22, "weight": "semibold", "design": "rounded" },
    "headline": { "size": 13, "weight": "semibold", "design": "default" },
    "body":     { "size": 13, "weight": "regular",  "design": "default" },
    "label":    { "size": 11, "weight": "medium",   "design": "default" },
    "caption":  { "size": 10, "weight": "medium",   "design": "default" },
    "metric":   { "size": 28, "weight": "semibold", "design": "rounded" },
    "mono":     { "size": 12, "weight": "regular",  "design": "monospaced" }
  },
  "motion": { "fast": 0.15, "normal": 0.3, "slow": 0.6 },
  "chart": {
    "lineWidth": 1.75,
    "fillOpacityTop": 0.38,
    "fillOpacityBottom": 0.0,
    "glowRadius": 6,
    "gaugeLineWidth": 10
  },
  "shadow": {
    "card": { "light": { "color": "#0F172A", "opacity": 0.06, "radius": 12, "y": 4 },
              "dark":  { "color": "#000000", "opacity": 0.35, "radius": 16, "y": 6 } }
  }
}
